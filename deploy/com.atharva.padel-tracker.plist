<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the padel occupancy collector.

  StartInterval is 1800 seconds because config.yaml sets poll.cadence_minutes: 30.
  The two are not wired together at runtime, so changing the cadence means editing
  both: the config value is what the coverage denominator is computed from, this
  value is what actually fires the process. A mismatch makes the dashboard report
  coverage against a schedule nobody is running.

  RunAtLoad is deliberately false. Loading the agent is an administrative act that
  can happen several times while you get the paths right, and each load would
  otherwise fire a real cycle at Hudle. The first scheduled run lands one interval
  after load; `launchctl start com.atharva.padel-tracker` triggers one on demand.

  There is no KeepAlive: `collect` is a one-shot command that exits, and restarting
  it on exit would turn a 30-minute cadence into an unbounded request loop against a
  third-party API.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atharva.padel-tracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/atharvakedia/Dev/padel-tracker/.venv/bin/python</string>
        <string>-m</string>
        <string>tracker</string>
        <string>collect</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/atharvakedia/Dev/padel-tracker</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/atharvakedia/Dev/padel-tracker/data/collect.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/atharvakedia/Dev/padel-tracker/data/collect.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd starts with a near-empty PATH; the venv python is absolute
             above, so this exists only for anything it shells out to. -->
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Explicit rather than relying on WorkingDirectory, so the agent keeps
             working if it is ever launched from somewhere else. -->
        <key>PADEL_TRACKER_CONFIG</key>
        <string>/Users/atharvakedia/Dev/padel-tracker/config.yaml</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
